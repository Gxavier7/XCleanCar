generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id        String   @id @default(uuid())

  name      String
  cpf       String?   @unique

  phone     String
  email     String?
  state     String?
  address   String?
  city      String?
  cards     Vehicle[]

  reference String?
  birthdate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id           String   @id @default(uuid())

  plate        String
  manufacturer String
  model        String
  vehicleType   String
  clientId     String
  client       Customer @relation(fields: [clientId], references: [id])

  createdAt    DateTime @default(now  ())
  updatedAt    DateTime @updatedAt
}